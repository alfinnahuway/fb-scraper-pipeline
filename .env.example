# Facebook Scraper Pipeline
# Environment configuration

# Apify API Token (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facebook cookies (from browser "Get cookies.txt LOCALLY" extension)
# Path to cookies.txt file exported from Facebook desktop browser
FB_COOKIES_PATH=./fb_cookies.txt

# DataImpulse rotating residential proxy (optional)
# Format: http://USER:PASS@HOST:PORT
DATAIMPULSE_PROXY=

# Output directory
OUTPUT_DIR=./output

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
